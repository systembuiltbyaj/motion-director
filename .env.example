# Voice provider settings for scripts/voice.mjs. Copy to .env (git-ignored) in this skill folder or in a
# project folder, and fill in only the provider you use. Kokoro (the default) needs nothing here.

# provider "elevenlabs"
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# provider "openai-compatible": any server with POST <base>/audio/speech, e.g. VoiceStudio on this machine
# (http://127.0.0.1:3900/v1) or https://api.openai.com/v1. The key is only needed if the server asks for one.
VOICE_API_BASE_URL=
VOICE_API_KEY=
